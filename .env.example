# Copy to .env.local for local dev: cp .env.example .env.local

# Base URL of the running backend (backend/, `uv run fastapi run main.py`).
# Also what `pnpm generate:api` points openapi-typescript at.
NEXT_PUBLIC_CUE_API_URL=http://localhost:8000

# Auth.js session-cookie signing secret. Optional in dev (Auth.js falls
# back to a warning, not an error, below v5's production check) — required
# once this is ever deployed anywhere but a laptop. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-change-me
